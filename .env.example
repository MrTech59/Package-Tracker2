# ---- Web server ----
HOST=0.0.0.0
PORT=8080

# ---- Storage ----
DATA_DIR=data

# ---- MCP browser server (picoclaw-browser in your LXC/network) ----
MCP_URL=http://192.168.3.137:8000/mcp
MCP_TIMEOUT_SECONDS=60
MCP_PROTOCOL_VERSION=2024-11-05

# ---- Scraper ----
# Set SCRAPE_ENABLED=false to run in manual-only mode (no outbound carrier requests).
SCRAPE_ENABLED=true
# How often the background loop re-checks active packages (seconds).
POLL_INTERVAL_SECONDS=3600
# Never re-check the same package more often than this (seconds).
MIN_SCRAPE_GAP_SECONDS=300
MAX_PAGE_CHARS=100000

# ---- Telegram notifications ----
# Create a bot with @BotFather, then message it and read your chat id.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional API key ----
# When set, API routes require the header:  X-Api-Key: <value>
API_KEY=
