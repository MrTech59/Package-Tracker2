# ---- Web server ----
HOST=0.0.0.0
PORT=8080

# ---- Storage ----
DATA_DIR=data

# ---- MCP browser server (picoclaw-browser in your LXC/network) ----
MCP_URL=http://192.168.3.137:8000/mcp
MCP_TIMEOUT_SECONDS=60
MCP_PROTOCOL_VERSION=2024-11-05

# ---- Scraper ----
# Set SCRAPE_ENABLED=false to run in manual-only mode (no outbound carrier requests).
SCRAPE_ENABLED=true
# How often the background loop re-checks active packages (seconds).
POLL_INTERVAL_SECONDS=3600
# Never re-check the same package more often than this (seconds).
MIN_SCRAPE_GAP_SECONDS=300
MAX_PAGE_CHARS=100000

# ---- Telegram notifications ----
# 1. Create a bot with @BotFather (/newbot).
# 2. Paste the token into the dashboard instead of here if you prefer:
#    Settings -> Telegram pairing -> Bot token -> Save token.
#    A token saved there is stored in the database and in this file, and wins
#    over the value below.
# 3. Leave TELEGRAM_CHAT_ID blank and use the dashboard's pairing button
#    (Settings -> Telegram pairing), or paste a chat id here manually.
#    A chat paired from the dashboard is stored in the database and wins over
#    this value, so you do not need to restart to change it.
# Leave TELEGRAM_ENABLED unset to let pairing switch alerts on automatically.
# Set it to false to force notifications off even when a chat is paired.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=false
# Point at a different Bot API server if you run one locally.
# TELEGRAM_API_BASE=https://api.telegram.org

# ---- Optional API key ----
# When set, API routes require the header:  X-Api-Key: <value>
API_KEY=
